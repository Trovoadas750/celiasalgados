# Copie para .env.local e preencha com os dados do projeto no Supabase
# (Project Settings > API). Use a chave PUBLISHABLE (sb_publishable_...) ou a anon key.
# NUNCA coloque a chave secreta (sb_secret_... / service_role) aqui.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# SÓ SERVIDOR (rotas em app/api). Sem NEXT_PUBLIC_: nunca vão para o navegador.
# Na Vercel, cadastre em Settings > Environment Variables (não commite os valores).
# Chave secreta do Supabase (sb_secret_...): Project Settings > API Keys.
# Usada pelas rotas /api/frete (cache de endereços) e /api/lembretes-pagamento.
SUPABASE_SECRET_KEY=
# Geoapify (geocodificação do frete). Conta grátis em geoapify.com > My Projects > API Key.
# Plano grátis: 3.000 requisições/dia; exige o crédito "Powered by Geoapify" perto do frete.
GEOAPIFY_API_KEY=
# Pagamento online dos agendamentos (InfinitePay: Pix e cartão de crédito).
# VAZIO = desligado: o "Pagar agora" abre o WhatsApp da loja. Preenchido = liga o pagamento online.
# É a InfiniteTag da conta que recebe o dinheiro, sem o "$" (ex.: celiasalgados).
INFINITEPAY_HANDLE=
# Endereço público do site, sem barra no fim (ex.: https://celiasalgados.com.br). A InfinitePay
# devolve o cliente para SITE_URL/api/pagamentos/retorno e avisa em SITE_URL/api/pagamentos/webhook.
# Vazio: usa o endereço da própria requisição.
SITE_URL=
# Opcional: só mude se a InfinitePay trocar o endereço da API (padrão: https://api.checkout.infinitepay.io).
INFINITEPAY_API_URL=

# Senha que o cron externo manda no header "Authorization: Bearer <CRON_SECRET>".
# Gere uma longa e aleatória, ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
